# ==============================================================================
# Gistly / Jitsly — Environment Configuration
# Copy this file to '.env' and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys (At least one key is recommended for cloud AI features)
# ------------------------------------------------------------------------------
# Google Gemini API Key: Primary LLM engine (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI API Key: Fallback LLM engine (https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# ------------------------------------------------------------------------------
# 2. AI Model & Provider Configuration (Optional — safe defaults provided)
# ------------------------------------------------------------------------------
# LLM Provider priority: 'auto' (Gemini first, fallback to Mistral), 'gemini', or 'mistral'
LLM_PROVIDER=auto

# Gemini Model identifier (e.g. gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Embeddings Provider: 'local' (MiniLM running on CPU) or 'gemini' (cloud text-embedding-004)
EMBEDDING_PROVIDER=local

# ------------------------------------------------------------------------------
# 3. Speech-to-Text (STT) Configuration (Optional)
# ------------------------------------------------------------------------------
# Sarvam AI Key: Required ONLY for Hindi/Hinglish speech translation (https://sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here

# Local Whisper model size: tiny, base, small, medium, large (default: small)
WHISPER_MODEL=small

# ------------------------------------------------------------------------------
# 4. Optional Advanced Settings (Uncomment only if overriding defaults)
# ------------------------------------------------------------------------------
# DEMO_MODE=false
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# YouTube Cookie File: Optional Netscape cookies.txt for bot-blocked YouTube downloads
# Place cookies.txt in project root or specify path below
# YOUTUBE_COOKIE_FILE=cookies.txt

