# ==============================================================================
# RecallAI — Environment Configuration
# Copy this file to '.env' and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys (At least one key is recommended for cloud AI features)
# ------------------------------------------------------------------------------
# Google Gemini API Key: Primary LLM engine (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI API Key: Fallback LLM engine (https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# ------------------------------------------------------------------------------
# 2. AI Model & Provider Configuration (Optional — safe defaults provided)
# ------------------------------------------------------------------------------
# LLM Provider priority: 'auto' (Gemini first, fallback to Mistral), 'gemini', or 'mistral'
LLM_PROVIDER=auto

# Gemini Model identifier (e.g. gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Embeddings Provider: 'local' (MiniLM running on CPU) or 'gemini' (cloud text-embedding-004)
EMBEDDING_PROVIDER=local

# ------------------------------------------------------------------------------
# 3. Speech-to-Text (STT) Configuration (Optional)
# ------------------------------------------------------------------------------
# Sarvam AI Key: Required ONLY for Hindi/Hinglish speech translation (https://sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here

# Local Whisper model size: tiny, base, small, medium, large (default: small)
WHISPER_MODEL=small

# ------------------------------------------------------------------------------
# 4. Optional Advanced / Production Settings (Uncomment only if overriding)
# ------------------------------------------------------------------------------
# DEMO_MODE=false
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.yourdomain.com
# MAX_UPLOAD_SIZE_MB=100
# MAX_AUDIO_DURATION_MINUTES=90.0
# MAX_TRANSCRIPT_CHARS=250000
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# YouTube Cookie File: Optional Netscape cookies.txt for bot-blocked YouTube downloads
# Place cookies.txt in project root or specify path below
# YOUTUBE_COOKIE_FILE=cookies.txt

# ------------------------------------------------------------------------------
# 5. Real-Time Voice Interaction (LiveKit Agents)
# ------------------------------------------------------------------------------
# LiveKit Cloud — Required for voice sessions (https://livekit.io)
# Get free credentials at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Deepgram API Key — Optional, for low-latency cloud STT (https://deepgram.com)
# If unset, the voice agent uses local Whisper for STT (slower but no API key needed)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key — Optional, for high-quality TTS via OpenAI (https://platform.openai.com)
# If unset, the voice agent falls back to gTTS (lower quality but no API key needed)
OPENAI_API_KEY=your_openai_api_key_here

# Voice agent TTS voice (used when OPENAI_API_KEY is set)
# Options: alloy, echo, fable, onyx, nova, shimmer
LIVEKIT_TTS_VOICE=nova

